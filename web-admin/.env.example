# ============================================================
# web-admin Environment Variables — TEMPLATE
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to git.
# ============================================================

# Supabase (get from https://app.supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Django backend API (Render / Railway / local)
VITE_DJANGO_API_BASE_URL=https://your-django-api.onrender.com

# ── Studio Auth Configuration ──────────────────────────────
# Owner PIN (numeric, shown on trusted devices only)
VITE_OWNER_PIN=change-me-to-your-pin

# Owner fallback passwords (comma-separated, used for demo/dev only)
VITE_OWNER_PASSWORDS=YourPassword1,YourPassword2

# Studio contact phone (shown in UI footer & login screen)
VITE_STUDIO_PHONE=+91 0000000000

# Studio contact email (shown in UI)
VITE_STUDIO_EMAIL=admin@yourstudio.com

# Demo customer email (for "Quick Login" demo button)
VITE_DEMO_CUSTOMER_EMAIL=demo.customer@example.com

# Internal session token key (arbitrary string — keep it private)
VITE_OWNER_SESSION_KEY=your-random-owner-session-token
