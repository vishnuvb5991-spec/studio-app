# ============================================================
# Heroku Environment Variables Reference
# Copy these into Heroku Dashboard → Settings → Config Vars
# ============================================================

# Django core
SECRET_KEY=your-super-secret-random-key-here
DEBUG=False
ALLOWED_HOSTS=*.herokuapp.com,localhost

# Database — Heroku sets this automatically when you add Heroku Postgres
# DATABASE_URL=postgres://user:pass@host:5432/db  (auto-provided by Heroku)

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Optional — AWS S3 for media file storage (recommended for production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
